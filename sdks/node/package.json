{
  "name": "@agentcomms/client",
  "version": "1.0.0",
  "description": "Official Node SDK for AgentComms — the agent communications hub.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "license": "FSL-1.1-Apache-2.0",
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "https://github.com/IntergalacticTech/FreeMail.ai.git",
    "directory": "sdks/node"
  },
  "dependencies": {},
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ES2022",
            "moduleResolution": "bundler"
          }
        }
      ]
    }
  }
}
