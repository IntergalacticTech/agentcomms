{
  "_comment": "Rollback DNS batch — operator fills HOSTED_ZONE_ID and restores the old API GW target.",
  "_usage": "aws route53 change-resource-record-sets --hosted-zone-id $HOSTED_ZONE_ID --change-batch file://tools/rollback-dns-batch.json",
  "_FILL_IN": [
    "Replace CLOUDFRONT_DIST_DOMAIN with the original victorymail API Gateway CloudFront domain",
    "e.g. d1abcdefg.cloudfront.net"
  ],
  "Comment": "Rollback: restore api.victorymail.dev to original API Gateway CloudFront distribution",
  "Changes": [
    {
      "Action": "UPSERT",
      "ResourceRecordSet": {
        "Name": "api.victorymail.dev.",
        "Type": "A",
        "AliasTarget": {
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "DNSName": "REPLACE_WITH_ORIGINAL_CLOUDFRONT_DOMAIN",
          "EvaluateTargetHealth": false
        }
      }
    },
    {
      "Action": "UPSERT",
      "ResourceRecordSet": {
        "Name": "api.victorymail.dev.",
        "Type": "AAAA",
        "AliasTarget": {
          "HostedZoneId": "Z2FDTNDATAQYW2",
          "DNSName": "REPLACE_WITH_ORIGINAL_CLOUDFRONT_DOMAIN",
          "EvaluateTargetHealth": false
        }
      }
    }
  ]
}
